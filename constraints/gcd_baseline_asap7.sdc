# TimingForge ASAP7 physical-flow constraint baseline.
# ASAP7 NLDM libraries use picosecond time units; time values below are ps.
# Output loads remain in fF. Same interface budget as gcd_baseline.sdc.
create_clock -name core_clk -period 10000.000 [get_ports clk]
set_clock_uncertainty -setup 150.000 [get_clocks core_clk]
set_clock_uncertainty -hold 50.000 [get_clocks core_clk]
set_clock_transition 50.000 [get_clocks core_clk]
set_input_delay -clock core_clk -max 1200.000 [get_ports start]
set_input_delay -clock core_clk -min 100.000 [get_ports start]
set_input_delay -clock core_clk -max 1500.000 [get_ports a_in*]
set_input_delay -clock core_clk -min 100.000 [get_ports a_in*]
set_input_delay -clock core_clk -max 1500.000 [get_ports b_in*]
set_input_delay -clock core_clk -min 100.000 [get_ports b_in*]
set_input_delay -clock core_clk -max 500.000 [get_ports rst]
set_input_delay -clock core_clk -min 50.000 [get_ports rst]
set_output_delay -clock core_clk -max 1000.000 [get_ports done]
set_output_delay -clock core_clk -min 100.000 [get_ports done]
set_output_delay -clock core_clk -max 1000.000 [get_ports busy]
set_output_delay -clock core_clk -min 100.000 [get_ports busy]
set_output_delay -clock core_clk -max 1500.000 [get_ports gcd_out*]
set_output_delay -clock core_clk -min 100.000 [get_ports gcd_out*]
set_load 20 [get_ports done]
set_load 20 [get_ports busy]
set_load 30 [get_ports gcd_out*]
set_input_transition 50.000 [get_ports {start rst a_in* b_in*}]
